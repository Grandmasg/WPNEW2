# Allow this site to be embedded in iframes from any origin
# Header always unset X-Frame-Options
# Header always set X-Frame-Options "ALLOWALL"

# Alternative: Use Content Security Policy (more modern approach)
# Uncomment the line below and comment out the X-Frame-Options lines above
# Header always set Content-Security-Policy "frame-ancestors *;"

# For specific domains only (more secure):
Header always set Content-Security-Policy "frame-ancestors 'self' https://whatpulse.org https://*.whatpulse.org;"

# Enable CORS if needed
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"

# Handle preflight requests
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]
